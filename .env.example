# ==============================================================================
# NOVARA — Production Deployment Environment Variables Template
# Copy to .env for local development or set in your Render / Cloud Dashboard.
# NEVER COMMIT REAL PRODUCTION CREDENTIALS OR SECRETS TO GIT.
# ==============================================================================

# ==============================================================================
# 1. PUBLIC FRONTEND CONFIGURATION (SAFE FOR BROWSER / VITE BUNDLE)
# ==============================================================================
# Google Identity Services Client ID for web frontend login button
# Obtained from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs (Type: Web application)
# Format: <numeric-project-id>-<hash>.apps.googleusercontent.com (e.g. 1234567890-abcdef.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ==============================================================================
# 2. SERVER-ONLY SECRETS & CONFIGURATION (NEVER EXPOSE TO FRONTEND / BROWSER)
# ==============================================================================
# Node Runtime & Networking
NODE_ENV=production
PORT=3000

# Base URLs (e.g. Render Web Service URL: https://novara-app.onrender.com)
APP_BASE_URL=https://your-service-name.onrender.com
API_BASE_URL=https://your-service-name.onrender.com/api

# Supabase Managed PostgreSQL Database Connection String
# Obtained from: Supabase Dashboard > Connect button (or Project Settings > Database) > Transaction Pooler (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# NOTE: Replace 'yourprojectref' with your actual 20-char project ref ID (e.g. postgres.abcdefghijklmnopqrst)
# NOTE: URL-encode special characters in password (e.g. # -> %23, @ -> %40)
DATABASE_URL=postgresql://postgres.yourprojectref:your_secure_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Custom SSL CA Certificate (Optional in local dev, Recommended on Render for secure verification)
# Obtained from: Supabase Dashboard > Project Settings > Database > SSL Certificate (Download prod-ca-2021.crt)
# Paste certificate contents (single-line with \n or multi-line) or base64 string in Render Dashboard Environment Variables
DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nYOUR_SUPABASE_CA_CERTIFICATE_HERE\n-----END CERTIFICATE-----"

# Google OAuth 2.0 Backend Verification Client ID (Matches VITE_GOOGLE_CLIENT_ID above)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Server-Side Cryptographic Session & JWT Secret (Min 64 random characters)
JWT_SECRET=generate_a_secure_random_64_character_secret_here

# AI Placement Intelligence & Roadmap Analysis API Key (Server-Side Only)
AI_API_KEY=your_gemini_or_cloud_ai_api_key_here

# Supabase Storage / S3-Compatible Object Storage (Private Bucket)
# Supabase S3 Endpoint: https://[project-ref].supabase.co/storage/v1/s3
STORAGE_ENDPOINT=https://yourprojectref.supabase.co/storage/v1/s3
STORAGE_BUCKET=novara-user-roadmaps
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_supabase_or_s3_access_key_id
STORAGE_SECRET_KEY=your_supabase_or_s3_secret_access_key

# Security & Strict CORS Allowlist (Comma-separated allowed web origins)
# In production, must match your exact Render service URL or custom domain
ALLOWED_ORIGINS=https://your-service-name.onrender.com
